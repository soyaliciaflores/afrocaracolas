# Sanity CMS
# Obtén estos valores en https://www.sanity.io/manage → tu proyecto → Settings → API
SANITY_PROJECT_ID=         # Ejemplo: abc123de
SANITY_DATASET=production  # O "staging" si usas otro entorno

# Donorbox
# URL de tu campaña: en Donorbox → tu campaña → "Donation Form" → copia la URL del iframe
DONORBOX_URL=              # Ejemplo: https://donorbox.org/embed/nombre-de-tu-campana
