---
interface Slide {
  title: string;
  slug: string;
  imageUrl: string;
  imageAlt: string;
}
interface Props {
  slides: Slide[];
}
const { slides } = Astro.props;
const multiple = slides.length > 1;
---

{slides.length > 0 && (
  <section
    class="carousel"
    id="hero-carousel"
    aria-label="Noticias destacadas"
  >
    <!-- Live region para lectores de pantalla -->
    <p class="sr-only" aria-live="polite" id="carousel-status"></p>

    <div class="carousel-track">
      {slides.map((slide, i) => (
        <div
          class={`carousel-slide${i === 0 ? ' active' : ''}`}
          aria-hidden={i !== 0 ? 'true' : 'false'}
          data-index={i}
        >
          <a
            href={`/notas/${slide.slug}`}
            class="slide-link"
            tabindex={i === 0 ? 0 : -1}
          >
            <img
              src={slide.imageUrl}
              alt={slide.imageAlt || slide.title}
              class="slide-img"
              loading={i === 0 ? 'eager' : 'lazy'}
            />
            <div class="slide-overlay" aria-hidden="true">
              <p class="slide-title">{slide.title}</p>
            </div>
          </a>
        </div>
      ))}
    </div>

    {multiple && (
      <>
        <button
          class="arrow arrow-prev"
          id="carousel-prev"
          aria-label="Imagen anterior"
          type="button"
        >
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"/>
          </svg>
        </button>

        <button
          class="arrow arrow-next"
          id="carousel-next"
          aria-label="Imagen siguiente"
          type="button"
        >
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"/>
          </svg>
        </button>

        <div class="dots" role="group" aria-label="Navegación del carrusel">
          {slides.map((slide, i) => (
            <button
              class={`dot${i === 0 ? ' active' : ''}`}
              type="button"
              aria-label={`Ir a imagen ${i + 1} de ${slides.length}: ${slide.title}`}
              aria-pressed={i === 0 ? 'true' : 'false'}
              data-index={i}
            />
          ))}
        </div>
      </>
    )}
  </section>
)}

<style>
  .carousel {
    position: relative;
    width: 100%;
    height: 60vh;
    overflow: hidden;
    background: #111;
  }

  /* Track */
  .carousel-track {
    position: relative;
    width: 100%;
    height: 100%;
  }

  /* Slides */
  .carousel-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.7s ease;
    pointer-events: none;
  }
  .carousel-slide.active {
    opacity: 1;
    pointer-events: auto;
  }

  /* Link & image */
  .slide-link {
    display: block;
    width: 100%;
    height: 100%;
    position: relative;
    text-decoration: none;
  }
  .slide-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: 0;
  }

  /* Overlay */
  .slide-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.72) 0%,
      rgba(0, 0, 0, 0.18) 45%,
      transparent 100%
    );
    display: flex;
    align-items: flex-end;
    padding: 2em 2.5em;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .carousel-slide.active .slide-link:hover .slide-overlay,
  .carousel-slide.active .slide-link:focus-visible .slide-overlay {
    opacity: 1;
  }
  .slide-title {
    color: #fff;
    font-size: clamp(1rem, 2.5vw, 1.5rem);
    font-weight: 700;
    margin: 0;
    line-height: 1.3;
    max-width: 680px;
    text-shadow: 0 1px 4px rgba(0,0,0,0.5);
  }

  /* Focus ring on slide link */
  .slide-link:focus-visible {
    outline: 3px solid #fff;
    outline-offset: -3px;
  }

  /* Arrows */
  .arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    background: rgba(255, 255, 255, 0.18);
    backdrop-filter: blur(4px);
    border: 1px solid rgba(255, 255, 255, 0.35);
    color: #fff;
    border-radius: 50%;
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.2s;
    flex-shrink: 0;
  }
  .arrow:hover,
  .arrow:focus-visible {
    background: rgba(255, 255, 255, 0.35);
    outline: 2px solid #fff;
    outline-offset: 2px;
  }
  .arrow-prev { left: 1.25em; }
  .arrow-next { right: 1.25em; }

  /* Dots */
  .dots {
    position: absolute;
    bottom: 1.25em;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 0.5em;
    z-index: 10;
  }
  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    border: 2px solid rgba(255, 255, 255, 0.7);
    background: transparent;
    cursor: pointer;
    padding: 0;
    transition: background 0.2s, border-color 0.2s;
  }
  .dot.active {
    background: #fff;
    border-color: #fff;
  }
  .dot:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }

  @media (max-width: 640px) {
    .carousel { height: 40vh; }
    .arrow { width: 38px; height: 38px; }
    .arrow-prev { left: 0.6em; }
    .arrow-next { right: 0.6em; }
    .slide-overlay { padding: 1.25em; }
  }
</style>

<script>
  const carousel = document.getElementById('hero-carousel');
  if (carousel) {
    const slides = Array.from(carousel.querySelectorAll<HTMLElement>('.carousel-slide'));
    const dots   = Array.from(carousel.querySelectorAll<HTMLButtonElement>('.dot'));
    const links  = Array.from(carousel.querySelectorAll<HTMLAnchorElement>('.slide-link'));
    const status = document.getElementById('carousel-status');
    const total  = slides.length;
    let current  = 0;
    let timer: ReturnType<typeof setInterval> | null = null;

    function goTo(index: number) {
      const prev = current;
      current = ((index % total) + total) % total;

      slides[prev].classList.remove('active');
      slides[prev].setAttribute('aria-hidden', 'true');
      links[prev].setAttribute('tabindex', '-1');

      slides[current].classList.add('active');
      slides[current].setAttribute('aria-hidden', 'false');
      links[current].setAttribute('tabindex', '0');

      dots.forEach((d, i) => {
        d.classList.toggle('active', i === current);
        d.setAttribute('aria-pressed', String(i === current));
      });

      if (status) {
        status.textContent = `Imagen ${current + 1} de ${total}`;
      }
    }

    function start() {
      if (total > 1) timer = setInterval(() => goTo(current + 1), 5000);
    }
    function stop() {
      if (timer) { clearInterval(timer); timer = null; }
    }
    function reset() { stop(); start(); }

    document.getElementById('carousel-prev')?.addEventListener('click', () => { goTo(current - 1); reset(); });
    document.getElementById('carousel-next')?.addEventListener('click', () => { goTo(current + 1); reset(); });

    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => { goTo(i); reset(); });
    });

    // Pause on hover / focus
    carousel.addEventListener('mouseenter', stop);
    carousel.addEventListener('mouseleave', start);
    carousel.addEventListener('focusin', stop);
    carousel.addEventListener('focusout', start);

    start();
  }
</script>
