---
import { Image } from 'astro:assets';
import logo from '../assets/logo.jpeg';
import HeaderLink from './HeaderLink.astro';
---

<header>
  <nav>
    <a class="logo" href="/">
      <Image src={logo} alt="Logo Afrocaracolas" height={44} class="logo-img" />
      <span class="logo-text">Afrocaracolas</span>
    </a>
    <button class="menu-toggle" aria-label="Abrir menú" aria-expanded="false" aria-controls="nav-links">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="3" y1="6" x2="21" y2="6"/>
        <line x1="3" y1="12" x2="21" y2="12"/>
        <line x1="3" y1="18" x2="21" y2="18"/>
      </svg>
    </button>
    <div class="nav-links" id="nav-links">
      <HeaderLink href="/">Inicio</HeaderLink>
      <HeaderLink href="/quienes-somos">Quiénes somos</HeaderLink>
      <HeaderLink href="/notas">Notas</HeaderLink>
      <a href="/donar" class="btn-donar">Donar</a>
    </div>
  </nav>
</header>

<script>
  const toggle = document.querySelector('.menu-toggle') as HTMLButtonElement;
  const links = document.getElementById('nav-links');
  toggle?.addEventListener('click', () => {
    const open = links?.classList.toggle('open');
    toggle.setAttribute('aria-expanded', String(open));
  });
</script>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(250, 250, 248, 0.96);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
    padding: 0 1.5em;
  }
  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 1100px;
    margin: 0 auto;
    height: 68px;
  }
  .logo {
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 0.6em;
    flex-shrink: 0;
  }
  .logo-img {
    height: 44px;
    width: auto;
    border-radius: 50%;
    display: block;
  }
  .logo-text {
    font-size: 1.15em;
    font-weight: 700;
    color: var(--accent);
    letter-spacing: 0.01em;
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: 0.25em;
  }
  .nav-links :global(a) {
    padding: 0.5em 0.75em;
    color: var(--text);
    text-decoration: none;
    border-radius: 6px;
    transition: color 0.15s, background 0.15s;
    font-size: 0.95em;
  }
  .nav-links :global(a:hover),
  .nav-links :global(a.active) {
    color: var(--accent);
    background: rgba(92, 45, 130, 0.08);
  }
  .btn-donar {
    display: inline-block;
    padding: 0.45em 1.1em;
    background: var(--accent);
    color: #fff !important;
    font-weight: 700;
    border-radius: 6px;
    text-decoration: none;
    margin-left: 0.5em;
    font-size: 0.9em;
    transition: background 0.15s;
  }
  .btn-donar:hover {
    background: var(--accent-light) !important;
    color: #fff !important;
  }
  .menu-toggle {
    display: none;
    background: transparent;
    border: none;
    color: var(--text);
    cursor: pointer;
    padding: 0.25em;
  }
  @media (max-width: 640px) {
    .menu-toggle { display: flex; }
    .logo-text { display: none; }
    .nav-links {
      display: none;
      position: absolute;
      top: 68px;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
      background: var(--bg);
      border-bottom: 1px solid var(--border);
      padding: 0.75em 1.5em 1.25em;
    }
    .nav-links.open { display: flex; }
    .nav-links :global(a) { width: 100%; padding: 0.6em 0.5em; }
    .btn-donar { margin-left: 0; margin-top: 0.5em; width: 100%; text-align: center; }
  }
</style>
