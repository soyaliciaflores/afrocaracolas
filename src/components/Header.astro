---
import { Image } from 'astro:assets';
import logo from '../assets/logo.jpeg';
import { DONA_LINK, NAV_LINKS, SITE_TITLE } from '../consts';
import Franja from './Franja.astro';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';

function estado(href: string) {
  if (href === path) return 'page';
  if (href !== '/' && path.startsWith(href + '/')) return 'seccion';
  return null;
}
---

<header class="site-header">
  <div class="barra contenedor">
    <a class="marca" href="/">
      <Image src={logo} alt="" width={56} height={56} densities={[1, 2]} loading="eager" />
      <span>{SITE_TITLE}</span>
    </a>

    <button
      class="menu-boton"
      type="button"
      aria-expanded="false"
      aria-controls="menu-principal"
      aria-label="Abrir menú"
      data-menu-boton
    >
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path class="icono-abrir" d="M3 6h18M3 12h18M3 18h18" />
        <path class="icono-cerrar" d="M6 6l12 12M18 6L6 18" />
      </svg>
    </button>

    <nav id="menu-principal" class="menu" aria-label="Principal">
      <ul>
        {NAV_LINKS.map(({ href, label }) => {
          const e = estado(href);
          return (
            <li>
              <a href={href} aria-current={e === 'page' ? 'page' : undefined} class:list={{ activo: e }}>
                {label}
              </a>
            </li>
          );
        })}
        <li>
          <a
            href={DONA_LINK.href}
            class="dona"
            aria-current={estado(DONA_LINK.href) === 'page' ? 'page' : undefined}
          >
            {DONA_LINK.label}
          </a>
        </li>
      </ul>
    </nav>
  </div>
  <Franja />
</header>

<script>
  const boton = document.querySelector<HTMLButtonElement>('[data-menu-boton]');
  const menu = document.getElementById('menu-principal');

  function poner(abierto: boolean) {
    if (!boton || !menu) return;
    menu.classList.toggle('abierto', abierto);
    boton.setAttribute('aria-expanded', String(abierto));
    boton.setAttribute('aria-label', abierto ? 'Cerrar menú' : 'Abrir menú');
  }

  boton?.addEventListener('click', () => poner(boton.getAttribute('aria-expanded') !== 'true'));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && boton?.getAttribute('aria-expanded') === 'true') {
      poner(false);
      boton.focus();
    }
  });
</script>

<style>
  .site-header {
    background: var(--color-negro);
  }
  .barra {
    padding-block: var(--space-4);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }
  .marca {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--color-blanco);
    text-decoration: none;
  }
  .marca img {
    width: 56px;
    height: 56px;
    border-radius: 999px;
  }
  .marca span {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 26px;
    line-height: 1;
  }

  .menu ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-5);
    font-size: var(--font-size-sm);
  }
  .menu a {
    color: var(--color-blanco);
    text-decoration: none;
  }
  .menu a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .menu a.activo {
    color: var(--color-mango);
    font-weight: 700;
  }
  .menu a.dona {
    display: inline-block;
    background: var(--color-dona);
    color: var(--color-dona-texto);
    font-weight: 800;
    padding: 10px var(--space-5);
    border-radius: var(--radius);
  }
  .menu a.dona:hover {
    text-decoration: none;
    background: var(--color-blanco);
  }

  .menu-boton {
    display: none;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    padding: 0;
    background: transparent;
    color: var(--color-blanco);
    border: 2px solid var(--color-linea);
    border-radius: var(--radius);
    cursor: pointer;
  }
  .icono-cerrar {
    display: none;
  }
  .menu-boton[aria-expanded='true'] .icono-abrir {
    display: none;
  }
  .menu-boton[aria-expanded='true'] .icono-cerrar {
    display: inline;
  }

  /* Menú colapsable: solo con JavaScript; sin JS el menú se acomoda en varias líneas. */
  @media (max-width: 1080px) {
    :global(.js) .menu-boton {
      display: inline-flex;
    }
    :global(.js) .menu {
      display: none;
      flex-basis: 100%;
    }
    :global(.js) .menu.abierto {
      display: block;
    }
    :global(.js) .menu ul {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      font-size: var(--font-size-base);
    }
    :global(.js) .menu li a:not(.dona) {
      display: block;
      padding: var(--space-3) 0;
      border-top: 1px solid var(--color-linea);
    }
    :global(.js) .menu a.dona {
      display: block;
      text-align: center;
      margin-top: var(--space-3);
      padding-block: var(--space-3);
    }
  }
</style>
