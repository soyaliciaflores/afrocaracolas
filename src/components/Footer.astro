---
const year = new Date().getFullYear();
---

<footer>
  <div class="footer-inner">
    <div class="footer-brand">
      <p class="footer-name">Afrocaracolas</p>
      <p class="footer-tagline">
        Mujeres afrodescendientes de la Costa Chica de Guerrero, México.
      </p>
    </div>
    <nav class="footer-nav" aria-label="Pie de página">
      <a href="/">Inicio</a>
      <a href="/quienes-somos">Quiénes somos</a>
      <a href="/notas">Notas</a>
      <a href="/donar">Donar</a>
    </nav>
  </div>
  <div class="footer-bottom">
    <p>© {year} Afrocaracolas · Costa Chica, Guerrero, México</p>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--border);
    margin-top: 4em;
    padding: 3em 1.5em 2em;
    color: var(--text-muted);
    font-size: 0.9em;
  }
  .footer-inner {
    max-width: 1100px;
    margin: 0 auto 2em;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 2em;
    flex-wrap: wrap;
  }
  .footer-name {
    font-size: 1.1em;
    font-weight: 700;
    color: var(--accent);
    margin: 0 0 0.25em;
  }
  .footer-tagline {
    margin: 0;
    max-width: 320px;
  }
  .footer-nav {
    display: flex;
    flex-direction: column;
    gap: 0.5em;
  }
  .footer-nav a {
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.15s;
  }
  .footer-nav a:hover { color: var(--accent); }
  .footer-bottom {
    max-width: 1100px;
    margin: 0 auto;
    border-top: 1px solid var(--border);
    padding-top: 1.5em;
    text-align: center;
  }
  .footer-bottom p { margin: 0; }
</style>
