---
import { Image } from 'astro:assets';
import logo from '../../assets/logo.jpeg';
import ImagenSanity from '../ImagenSanity.astro';
import Marcador from '../Marcador.astro';
import { colorEje } from '../../data/ejes';
import { fechaDeDia } from '../../lib/formato';
import type { PublicacionRedes } from '../../lib/queries';
import { urlImagen } from '../../lib/sanity';

interface Props {
  publicaciones: PublicacionRedes[];
  instagram?: string;
}
const { publicaciones, instagram } = Astro.props;

const REDES = { instagram: 'Instagram', facebook: 'Facebook', tiktok: 'TikTok' } as const;
const NEUTRO = { color: 'var(--color-negro-2)', colorTexto: 'var(--color-blanco)' };

const pubs = publicaciones.slice(0, 4).map((p) => ({
  ...p,
  tono: p.eje ? colorEje(p.eje.slug) : NEUTRO,
  detalle: [fechaDeDia(p.fecha), p.lugar].filter(Boolean).join(' · '),
}));
---

<section class="seccion territorio" aria-labelledby="territorio-titulo">
  <div class="contenedor fila" data-territorio>
    <div class="telefono-columna">
      <div class="telefono">
        {
          pubs.length === 0 ? (
            <div class="pantalla" style={`--p-fondo: ${NEUTRO.color}; --p-tinta: ${NEUTRO.colorTexto}`}>
              <div class="notch" aria-hidden="true" />
              <div class="medio">
                <Marcador texto="Video o portada de la publicación" fondo="var(--color-negro)" />
              </div>
              <div class="cuenta">
                <Image src={logo} alt="" width={28} height={28} />
                <span>@afrocaracolas</span>
              </div>
            </div>
          ) : (
            pubs.map((p, i) => (
              <div
                class="pantalla"
                data-pub={i}
                hidden={i !== 0}
                style={`--p-fondo: ${p.tono.color}; --p-tinta: ${p.tono.colorTexto}`}
              >
                <div class="notch" aria-hidden="true" />
                <div class="medio">
                  {p.video ? (
                    <video
                      controls
                      muted
                      playsinline
                      preload="none"
                      poster={p.portada ? urlImagen(p.portada, 600, 1100) : undefined}
                      aria-label={`Video: ${p.titulo}`}
                    >
                      <source src={p.video} />
                    </video>
                  ) : p.portada ? (
                    <ImagenSanity imagen={p.portada} proporcion={9 / 16} sizes="272px" anchos={[272, 544]} />
                  ) : (
                    <Marcador texto="Portada de la publicación" fondo="var(--color-negro)" />
                  )}
                </div>
                <div class="cuenta">
                  <Image src={logo} alt="" width={28} height={28} />
                  <span>@afrocaracolas</span>
                </div>
              </div>
            ))
          )
        }
      </div>
    </div>

    <div class="contenido">
      <div class="cabecera">
        <h2 id="territorio-titulo" class="etiqueta">Desde territorio · lo más reciente</h2>
        {
          instagram && (
            <a class="seguir" href={instagram}>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <rect x="3" y="3" width="18" height="18" rx="5" />
                <circle cx="12" cy="12" r="4" />
                <circle cx="17.5" cy="6.5" r="1" fill="currentColor" />
              </svg>
              Síguenos @afrocaracolas
            </a>
          )
        }
      </div>

      {
        pubs.length === 0 ? (
          <Marcador texto="Carga publicaciones de redes en el Studio" fondo="var(--color-blanco)" tinta="var(--color-negro)" />
        ) : (
          pubs.map((p, i) => (
            <article class="tarjeta" data-pub={i} hidden={i !== 0}>
              <div class="chips">
                {p.eje && (
                  <span class="chip" style={`background: ${p.tono.color}; color: ${p.tono.colorTexto}`}>
                    Eje · {p.eje.nombre}
                  </span>
                )}
                <span class="chip chip-gris">{p.detalle}</span>
              </div>
              <h3>{p.titulo}</h3>
              {p.texto && <p class="texto">{p.texto}</p>}
              <div class="acciones">
                {p.eje && p.proyecto && (
                  <a class="boton" href={`/ejes/${p.eje.slug}/${p.proyecto.slug}`}>
                    Conoce el proyecto
                  </a>
                )}
                <a
                  class="boton"
                  href={p.url}
                  style="--b-fondo: var(--color-blanco); --b-tinta: var(--color-negro); --b-borde: var(--color-negro)"
                >
                  Ver en {REDES[p.red]}
                </a>
              </div>
            </article>
          ))
        )
      }

      {
        pubs.length > 1 && (
          <div class="mas">
            <div class="mas-cabecera">
              <p class="mas-titulo">Más publicaciones</p>
              <div class="flechas">
                <button type="button" class="flecha" data-mover="-1" aria-label="Publicación anterior">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M15 18l-6-6 6-6" />
                  </svg>
                </button>
                <button type="button" class="flecha flecha-negra" data-mover="1" aria-label="Publicación siguiente">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M9 18l6-6-6-6" />
                  </svg>
                </button>
              </div>
            </div>
            <div class="miniaturas">
              {pubs.map((p, i) => (
                <button
                  type="button"
                  class="miniatura"
                  data-ir={i}
                  aria-pressed={i === 0 ? 'true' : 'false'}
                  aria-label={`Ver ${p.titulo}`}
                  style={`--p-fondo: ${p.tono.color}; --p-tinta: ${p.tono.colorTexto}`}
                >
                  {p.portada && (
                    <ImagenSanity imagen={p.portada} proporcion={4 / 5} sizes="120px" anchos={[160, 320]} decorativa />
                  )}
                  <span>{p.titulo}</span>
                </button>
              ))}
            </div>
          </div>
        )
      }
    </div>
  </div>
</section>

<script>
  for (const raiz of document.querySelectorAll<HTMLElement>('[data-territorio]')) {
    const vistas = Array.from(raiz.querySelectorAll<HTMLElement>('[data-pub]'));
    const miniaturas = Array.from(raiz.querySelectorAll<HTMLButtonElement>('[data-ir]'));
    const total = miniaturas.length;
    let actual = 0;

    const mostrar = (i: number) => {
      actual = (i + total) % total;
      for (const v of vistas) {
        const visible = Number(v.dataset.pub) === actual;
        v.hidden = !visible;
        if (!visible) v.querySelectorAll('video').forEach((video) => video.pause());
      }
      miniaturas.forEach((m, k) => m.setAttribute('aria-pressed', String(k === actual)));
    };

    miniaturas.forEach((m, k) => m.addEventListener('click', () => mostrar(k)));
    raiz.querySelectorAll<HTMLButtonElement>('[data-mover]').forEach((b) =>
      b.addEventListener('click', () => mostrar(actual + Number(b.dataset.mover))),
    );
  }
</script>

<style>
  .territorio {
    --s-fondo: var(--color-azul);
    --color-foco: var(--color-blanco);
  }
  .territorio > .contenedor {
    padding-block: var(--space-9);
  }
  .fila {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-8);
  }
  .telefono-columna {
    flex: 0 1 340px;
    min-width: 0;
    display: flex;
    justify-content: center;
  }
  .telefono {
    width: 300px;
    max-width: calc(100% - 16px);
    background: var(--color-negro);
    border-radius: 48px;
    padding: 14px;
    box-shadow: 16px 16px 0 var(--color-mango);
  }
  .pantalla {
    aspect-ratio: 9 / 19;
    background: var(--p-fondo);
    color: var(--p-tinta);
    border-radius: 36px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: 20px;
  }
  .pantalla[hidden] {
    display: none;
  }
  .notch {
    align-self: center;
    flex: 0 0 auto;
    width: 90px;
    height: 24px;
    background: var(--color-negro);
    border-radius: 999px;
  }
  .medio {
    flex: 1 1 auto;
    min-height: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .medio video,
  .medio :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--radius-sm);
    background: var(--color-negro);
  }
  .cuenta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 13px;
    font-weight: 700;
  }
  .cuenta img {
    width: 28px;
    height: 28px;
    border-radius: 999px;
    background: var(--color-blanco);
  }

  .contenido {
    flex: 1 1 520px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .cabecera {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }
  h2 {
    font-family: var(--font-body);
    font-size: var(--font-size-etiqueta);
  }
  .seguir {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    background: var(--color-negro);
    color: var(--color-blanco);
    text-decoration: none;
    font-weight: 700;
    font-size: 15px;
    padding: var(--space-2) 14px;
    border-radius: var(--radius);
  }
  .seguir:hover {
    color: var(--color-blanco);
    text-decoration: underline;
  }

  .tarjeta {
    background: var(--color-blanco);
    color: var(--color-negro);
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    box-shadow: var(--sombra-solida) var(--color-negro);
    margin-right: 10px;
    --color-foco: var(--color-negro);
  }
  .tarjeta[hidden] {
    display: none;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .chip {
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 700;
    padding: var(--space-1) 10px;
    border-radius: var(--radius-sm);
  }
  .chip-gris {
    background: #f1eef2;
    color: #3a3245;
    text-transform: none;
    letter-spacing: 0;
  }
  h3 {
    font-size: clamp(30px, 4vw, 40px);
    line-height: 1.04;
  }
  .texto {
    color: #3a3245;
  }
  .acciones {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding-top: var(--space-1);
  }
  .acciones .boton {
    font-size: var(--font-size-sm);
    padding: 10px 20px;
  }

  .mas {
    display: none;
    flex-direction: column;
    gap: 10px;
  }
  :global(.js) .mas {
    display: flex;
  }
  .mas-cabecera {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }
  .mas-titulo {
    font-size: 15px;
    font-weight: 700;
  }
  .flechas {
    display: flex;
    gap: var(--space-2);
  }
  .flecha {
    width: 44px;
    height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius);
    border: 2px solid var(--color-negro);
    background: var(--color-blanco);
    color: var(--color-negro);
    cursor: pointer;
  }
  .flecha-negra {
    background: var(--color-negro);
    color: var(--color-blanco);
  }
  .miniaturas {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-3);
  }
  .miniatura {
    position: relative;
    aspect-ratio: 4 / 5;
    background: var(--p-fondo);
    color: var(--p-tinta);
    border: 2px solid var(--color-negro);
    padding: 10px;
    display: flex;
    align-items: flex-end;
    text-align: left;
    cursor: pointer;
    font: inherit;
    font-size: 13px;
    font-weight: 700;
    line-height: 1.25;
    overflow: hidden;
  }
  .miniatura :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .miniatura span {
    position: relative;
  }
  .miniatura:has(img) span {
    background: var(--color-negro);
    color: var(--color-blanco);
    padding: 2px var(--space-1);
  }
  .miniatura[aria-pressed='true'] {
    border: 4px solid var(--color-blanco);
  }
  @media (max-width: 480px) {
    .miniaturas {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
