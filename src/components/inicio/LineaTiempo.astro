---
import Marcador from '../Marcador.astro';
import { colorEje } from '../../data/ejes';
import { anio, diaYMes } from '../../lib/formato';
import type { NotaResumen } from '../../lib/queries';

interface Props {
  momentos: NotaResumen[];
}
const { momentos } = Astro.props;

// Sin eje, el momento va en mango.
const lista = momentos
  .filter((m) => m.fecha)
  .map((m) => ({ ...m, color: m.eje ? colorEje(m.eje.slug).color : 'var(--color-mango)' }));
---

<section class="seccion tiempo" aria-labelledby="tiempo-titulo">
  <div class="contenedor">
    <div class="encabezado">
      <div class="encabezado-texto">
        <p class="etiqueta">Afrocaracolas en el tiempo</p>
        <h2 id="tiempo-titulo" class="titulo-seccion">El camino que hemos andado</h2>
      </div>
      <a class="ver-todo" href="/en-el-tiempo">Ver la línea del tiempo completa</a>
    </div>

    {
      lista.length === 0 ? (
        <Marcador texto="Momentos de la línea del tiempo: márcalos en Notas y momentos" />
      ) : (
        <div class="linea">
          <div class="riel" aria-hidden="true" />
          <ol>
            {lista.map((m) => (
              <li style={`--m-color: ${m.color}`}>
                <span class="punto" aria-hidden="true" />
                <p class="anio">
                  <time datetime={m.fecha}>{anio(m.fecha!)}</time>
                </p>
                <p class="etiqueta fecha">{diaYMes(m.fecha!)}</p>
                <h3>{m.titulo}</h3>
                {m.resumen && <p class="resumen">{m.resumen}</p>}
                {m.eje && <p class="eje">Eje · {m.eje.nombre}</p>}
              </li>
            ))}
          </ol>
        </div>
      )
    }
  </div>
</section>

<style>
  .contenedor {
    display: flex;
    flex-direction: column;
    gap: 44px;
  }
  .encabezado {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-4);
  }
  .encabezado-texto {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    max-width: 720px;
  }
  .encabezado .etiqueta {
    color: var(--color-mango);
  }
  .ver-todo {
    font-weight: 700;
  }
  .linea {
    position: relative;
  }
  .riel {
    position: absolute;
    left: 0;
    right: 0;
    top: 11px;
    height: 4px;
    background: var(--color-linea);
  }
  ol {
    position: relative;
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(220px, 100%), 1fr));
    gap: 28px;
  }
  li {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .punto {
    width: 26px;
    height: 26px;
    background: var(--m-color);
    border: 4px solid var(--color-negro);
    outline: 2px solid var(--m-color);
  }
  /* El año va en blanco: algunos colores de eje no llegan a 4.5:1 sobre negro. */
  .anio {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 34px;
    line-height: 1;
    padding-bottom: var(--space-2);
    border-bottom: 4px solid var(--m-color);
    align-self: flex-start;
  }
  .fecha {
    color: #bdb3bf;
    letter-spacing: 0.08em;
  }
  h3 {
    font-size: 22px;
    line-height: 1.15;
  }
  .resumen {
    font-size: var(--font-size-sm);
    color: var(--color-gris-texto);
  }
  .eje {
    font-size: var(--font-size-sm);
    font-weight: 700;
  }
  /* En una columna el riel horizontal ya no tiene sentido. */
  @media (max-width: 520px) {
    .riel {
      display: none;
    }
  }
</style>
