---
import Carousel from '../components/Carousel.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getCarouselNotas, getUltimasNotas } from '../lib/queries';

const [carouselNotas, notas] = await Promise.all([
  getCarouselNotas(),
  getUltimasNotas(3),
]);

const carouselSlides = carouselNotas.map((n) => ({
  title: n.title,
  slug: n.slug.current,
  imageUrl: n.heroImage.asset.url,
  imageAlt: n.heroImage.asset.altText ?? n.title,
}));
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <!-- Carrusel antes del header -->
  <Carousel slides={carouselSlides} slot="after-header" />

  <!-- Quiénes somos (resumen) -->
  <section class="section first">
    <h2 class="section-title">Quiénes somos</h2>
    <p>
      Somos una organización de mujeres afromexicanas que trabaja por el reconocimiento,
      la visibilización y la defensa de los derechos de los pueblos afrodescendientes
      en la Costa Chica de Guerrero y Oaxaca.
    </p>
    <p>
      A través de la educación, la cultura y la incidencia política, construimos
      comunidad y exigimos la plena ciudadanía de nuestros pueblos.
    </p>
    <a href="/quienes-somos" class="link-more">Leer más →</a>
  </section>

  <!-- Últimas notas -->
  <section class="section">
    <h2 class="section-title">Últimas notas</h2>
    {
      notas.length === 0 ? (
        <p class="empty">Próximamente compartiremos noticias y reflexiones.</p>
      ) : (
        <ul class="notas-grid">
          {notas.map((nota) => (
            <li class="card nota-card">
              {nota.heroImage && (
                <img
                  class="nota-img"
                  src={nota.heroImage.asset.url}
                  alt={nota.heroImage.asset.altText ?? nota.title}
                />
              )}
              <div class="nota-body">
                <time class="nota-date">
                  <FormattedDate date={new Date(nota.publishedAt)} />
                </time>
                <h3>
                  <a href={`/notas/${nota.slug.current}`}>{nota.title}</a>
                </h3>
                {nota.excerpt && <p class="nota-excerpt">{nota.excerpt}</p>}
              </div>
            </li>
          ))}
        </ul>
      )
    }
    <div class="section-footer">
      <a href="/notas" class="btn btn-outline">Ver todas las notas</a>
    </div>
  </section>

  <!-- CTA Donar -->
  <section class="section donar-cta">
    <div class="card donar-card">
      <h2>Apoya nuestro trabajo</h2>
      <p>
        Tu donación nos permite continuar con talleres, investigación y defensa comunitaria.
        Puedes donar desde cualquier parte del mundo.
      </p>
      <a href="/donar" class="btn">Donar ahora</a>
    </div>
  </section>
</BaseLayout>

<style>
  .section {
    padding: 3em 0;
    border-top: 1px solid var(--border);
  }
  .first { border-top: none; padding-top: 2em; }
  .section-title {
    color: var(--accent);
    margin-bottom: 1em;
  }
  .link-more {
    display: inline-block;
    margin-top: 0.5em;
    color: var(--accent-secondary);
    font-weight: 600;
    text-decoration: none;
  }
  .link-more:hover { text-decoration: underline; }
  .notas-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5em;
  }
  .nota-card { padding: 0; overflow: hidden; }
  .nota-img {
    width: 100%;
    height: 180px;
    object-fit: cover;
    border-radius: 8px 8px 0 0;
    display: block;
  }
  .nota-body { padding: 1.25em; }
  .nota-date {
    display: block;
    font-size: 0.8em;
    color: var(--accent-secondary);
    margin-bottom: 0.4em;
  }
  .nota-card h3 {
    font-size: 1.1em;
    margin: 0 0 0.4em;
  }
  .nota-card h3 a {
    color: var(--text);
    text-decoration: none;
  }
  .nota-card h3 a:hover { color: var(--accent); }
  .nota-excerpt {
    font-size: 0.9em;
    color: var(--text-muted);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .section-footer {
    margin-top: 2em;
    text-align: center;
  }
  .empty { color: var(--text-muted); font-style: italic; }
  .donar-cta { border-bottom: none; }
  .donar-card {
    text-align: center;
    padding: 3em 2em;
    background: linear-gradient(135deg, var(--bg-card), #e8e0f0);
  }
  .donar-card h2 {
    color: var(--accent);
    margin-bottom: 0.5em;
  }
  .donar-card p {
    color: var(--text-muted);
    max-width: 480px;
    margin: 0 auto 1.5em;
  }
  @media (max-width: 640px) {
    .notas-grid { grid-template-columns: 1fr; }
  }
</style>
