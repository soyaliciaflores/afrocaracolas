---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import EnConstruccion from '../../../components/EnConstruccion.astro';
import { colorEje } from '../../../data/ejes';
import { getProyecto, getProyectos, type ProyectoResumen } from '../../../lib/queries';

export async function getStaticPaths() {
  const proyectos = await getProyectos();
  return proyectos.map((proyecto) => ({
    params: { eje: proyecto.eje.slug, proyecto: proyecto.slug },
    props: { proyecto },
  }));
}

interface Props {
  proyecto: ProyectoResumen;
}
const { proyecto: resumen } = Astro.props;
const proyecto = (await getProyecto(resumen.eje.slug, resumen.slug)) ?? resumen;
const { color, colorTexto } = colorEje(proyecto.eje.slug);
---

<BaseLayout title={proyecto.nombre} description={proyecto.resumen}>
  <EnConstruccion
    titulo={proyecto.nombre}
    etiqueta={`Eje · ${proyecto.eje.nombre}`}
    bloque={4}
    color={color}
    colorTexto={colorTexto}
  />
</BaseLayout>
