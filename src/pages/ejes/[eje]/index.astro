---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import EnConstruccion from '../../../components/EnConstruccion.astro';
import { colorEje } from '../../../data/ejes';
import { getEje, getEjes, type EjeResumen } from '../../../lib/queries';

export async function getStaticPaths() {
  const ejes = await getEjes();
  return ejes.map((eje) => ({
    params: { eje: eje.slug },
    props: { eje, total: ejes.length },
  }));
}

interface Props {
  eje: EjeResumen;
  total: number;
}
const { eje: resumen, total } = Astro.props;
const eje = (await getEje(resumen.slug)) ?? resumen;
const { color, colorTexto } = colorEje(eje.slug);
---

<BaseLayout title={eje.nombre} description={eje.descripcionCorta}>
  <EnConstruccion
    titulo={eje.nombre}
    etiqueta={`Eje ${eje.orden} de ${total}`}
    bloque={4}
    color={color}
    colorTexto={colorTexto}
  />
</BaseLayout>
