---
import type { Nota } from '../lib/queries';
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';

interface Props {
  nota: Nota;
}
const { nota } = Astro.props;
---

<BaseLayout title={nota.title} description={nota.excerpt} image={nota.heroImage?.asset.url}>
  <article class="nota">
    {
      nota.heroImage && (
        <div class="hero-image">
          <img
            src={nota.heroImage.asset.url}
            alt={nota.heroImage.asset.altText ?? nota.title}
          />
        </div>
      )
    }
    <div class="nota-header">
      <a class="back" href="/notas">← Todas las notas</a>
      <h1>{nota.title}</h1>
      <time class="pub-date">
        <FormattedDate date={new Date(nota.publishedAt)} />
      </time>
      {nota.excerpt && <p class="excerpt">{nota.excerpt}</p>}
      <hr />
    </div>
    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .nota {
    max-width: 720px;
    margin: 0 auto;
  }
  .hero-image {
    margin-bottom: 2em;
    border-radius: 10px;
    overflow: hidden;
  }
  .hero-image img {
    width: 100%;
    height: 380px;
    object-fit: cover;
    display: block;
  }
  .back {
    display: inline-block;
    margin-bottom: 1em;
    color: var(--text-muted);
    font-size: 0.9em;
    text-decoration: none;
  }
  .back:hover { color: var(--accent); }
  h1 { font-size: 2.2em; margin-bottom: 0.3em; }
  .pub-date {
    display: block;
    color: var(--accent);
    font-size: 0.9em;
    margin-bottom: 0.75em;
  }
  .excerpt {
    color: var(--text-muted);
    font-size: 1.05em;
    margin: 0.5em 0 1em;
  }
  hr { border-color: var(--border); margin: 1.5em 0; }
</style>
